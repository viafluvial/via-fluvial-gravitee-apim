# Dominio e clusters
GIO_DOMAIN_BASE=plataforma.prd.viafluvial.com.br
GIO_REPOSITORY_CLUSTER=repository
GIO_MANAGEMENT_CLUSTER=management
GIO_GATEWAY_CLUSTER=gateway

# Repository
GIO_MONGODB_VERSION=6.0.5
GIO_MONGO_USERNAME=gio
GIO_MONGO_PASSWORD=change-me
GIO_MONGO_APPLICATION=mongodb-gio
GIO_MONGO_HOST=mongodb-gio.repository.plataforma.prd.viafluvial.com.br

GIO_MONGO_EXPRESS_VERSION=1.0.0-18
GIO_MONGO_ROOT_USERNAME=gio
GIO_MONGO_ROOT_PASSWORD=change-me
GIO_MONGO_EXPRESS_USERNAME=gio-admin
GIO_MONGO_EXPRESS_PASSWORD=change-me
GIO_MONGO_EXPRESS_APPLICATION=mongo-express-gio

GIO_ELASTICSEARCH_VERSION=8.13.4
GIO_ELASTICSEARCH_APPLICATION=elasticsearch-gio
GIO_ELASTICSEARCH_HOST=elasticsearch-gio.repository.plataforma.prd.viafluvial.com.br
GIO_ELASTICSEARCH_USERNAME=gio
GIO_ELASTICSEARCH_PASSWORD=change-me

GIO_KIBANA_VERSION=8.13.4
GIO_KIBANA_APPLICATION=kibana-gio

# Management
GIO_APIM_VERSION=3.20.32
GIO_PORTAL_UI_IMAGE=graviteeio/apim-portal-ui:3.20.32
GIO_API_CONSOLE_APPLICATION=api-console-gio
GIO_PORTAL_APPLICATION=portal-gio
GIO_CONSOLE_APPLICATION=console-gio

GIO_MANAGEMENT_API_URL=https://api-console-gio.management.plataforma.prd.viafluvial.com.br
GIO_CONSOLE_UI_URL=https://console-gio.management.plataforma.prd.viafluvial.com.br
GIO_PORTAL_UI_URL=https://portal-gio.management.plataforma.prd.viafluvial.com.br

GIO_SMTP_HOST=smtp-relay.gmail.com
GIO_SMTP_PORT=465
GIO_SMTP_FROM=noreply@viafluvial.com.br
# GIO_SMTP_USER=
# GIO_SMTP_PASSWORD=

# Gateway
GIO_API_GATEWAY_APPLICATION=api-gateway-gio
GIO_GATEWAY_URL=https://api-gateway-gio.gateway.plataforma.prd.viafluvial.com.br
